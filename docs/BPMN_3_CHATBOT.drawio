  <diagram id="bpmn3" name="Chatbot hỗ trợ">
    <mxGraphModel dx="1280" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Pool -->
        <mxCell id="pool" value="Luồng Chatbot" style="swimlane;startSize=30;horizontal=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="20" y="20" width="1240" height="560" as="geometry"/>
        </mxCell>

        <!-- Lane: Khách hàng -->
        <mxCell id="lane_cust" value="Khách hàng" style="swimlane;startSize=30;horizontal=0;fillColor=#f2f9ff;strokeColor=#6c8ebf;fontSize=12;fontStyle=1" vertex="1" parent="pool">
          <mxGeometry x="0" y="0" width="1240" height="180" as="geometry"/>
        </mxCell>

        <!-- Lane: API Chatbot -->
        <mxCell id="lane_api" value="Hệ thống (API Chatbot)" style="swimlane;startSize=30;horizontal=0;fillColor=#f0fff0;strokeColor=#82b366;fontSize=12;fontStyle=1" vertex="1" parent="pool">
          <mxGeometry x="0" y="180" width="1240" height="380" as="geometry"/>
        </mxCell>

        <!-- Customer: start and input -->
        <mxCell id="start" value="Start" style="shape=bpmn.startEvent;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_cust">
          <mxGeometry x="40" y="72" width="36" height="36" as="geometry"/>
        </mxCell>

        <mxCell id="task_input" value="Nhập câu hỏi vào widget" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_cust">
          <mxGeometry x="100" y="60" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="task_show" value="Hiển thị câu trả lời cho khách" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_cust">
          <mxGeometry x="980" y="60" width="180" height="60" as="geometry"/>
        </mxCell>

        <!-- API lane: receive, classify, query, call AI -->
        <mxCell id="api_receive" value="Tiếp nhận tin nhắn từ client" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="100" y="220" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="api_classify" value="Phân loại ý định" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="320" y="220" width="160" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="gw_need" value="Cần dữ liệu SP?" style="shape=bpmn.exclusiveGateway;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="520" y="222" width="48" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="task_query" value="Truy vấn catalog (MongoDB)" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="600" y="200" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="task_callai" value="Gọi OpenAI GPT API" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="820" y="220" width="180" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="gw_api_ok" value="API thành công?" style="shape=bpmn.exclusiveGateway;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="1020" y="222" width="48" height="48" as="geometry"/>
        </mxCell>

        <mxCell id="task_ai_response" value="Nhận phản hồi AI & sinh câu trả lời" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="1100" y="200" width="200" height="60" as="geometry"/>
        </mxCell>

        <mxCell id="task_fallback" value="Tạo phản hồi dự phòng (fallback)" style="shape=bpmn.task;whiteSpace=wrap;fontSize=11" vertex="1" parent="lane_api">
          <mxGeometry x="1100" y="300" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- API -> Customer: return -->
        <mxCell id="flow_c2api" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="task_input" target="api_receive" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="api_receive" target="api_classify" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="api_classify" target="gw_need" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="gw_need" target="task_query" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="task_query" target="task_callai" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="task_callai" target="gw_api_ok" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow_ok" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="gw_api_ok" target="task_ai_response" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow_err" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="gw_api_ok" target="task_fallback" parent="lane_api"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow_return" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="task_ai_response" target="task_show" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow_return_fb" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=1;" edge="1" source="task_fallback" target="task_show" parent="pool"><mxGeometry relative="1" as="geometry"/></mxCell>

      </root>
