        <mxCell id="flow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="gw_consult" target="task_addcart" parent="lane_customer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="task_addcart" target="gw_auth" parent="lane_customer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="gw_auth" target="task_auth" parent="lane_customer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="gw_auth" target="task_shipping" parent="lane_customer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="task_auth" target="task_shipping" parent="lane_customer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="flow10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;" edge="1" source="task_shipping" target="task_confirm" parent="pool1"><mxGeometry relative="1" as="geometry"/></mxCell>

